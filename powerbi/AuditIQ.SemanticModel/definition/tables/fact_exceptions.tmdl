table fact_exceptions
	lineageTag: 6f81367e-ebc8-5dd9-bc10-9d145aa58ab3

	measure 'Potential Exceptions' = COUNTROWS(fact_exceptions)
		formatString: #,0
		lineageTag: 0c54d6a0-53f1-5b01-b67d-a4f15eb0d8e6

	measure 'High Priority Findings' = CALCULATE(COUNTROWS(fact_exceptions), fact_exceptions[is_high_priority] = TRUE())
		formatString: #,0
		lineageTag: 9db565f6-922d-5baa-bdbe-562d554bde8b

	measure 'Rule Findings' = CALCULATE(COUNTROWS(fact_exceptions), fact_exceptions[detection_source] = "RULE")
		formatString: #,0
		lineageTag: d1734fdf-0597-5c8f-bd08-0b98b629a59c

	measure 'Model Findings' = CALCULATE(COUNTROWS(fact_exceptions), fact_exceptions[detection_source] = "ML")
		formatString: #,0
		lineageTag: 0491fb7f-fbf4-5884-83e1-d2f3e65b86b9

	measure 'Findings Awaiting Review' = CALCULATE(COUNTROWS(fact_exceptions), fact_exceptions[exception_status] = "OPEN")
		formatString: #,0
		lineageTag: a38a1172-caa7-5a6b-8fa5-912e217d3c30

	measure 'Flagged Value' = SUM(fact_exceptions[amount])
		formatString: \R #,0
		lineageTag: 0d60b0bf-d2c0-5648-b8b1-a647697f536f

	measure 'Max Anomaly Score' = MAX(fact_exceptions[anomaly_score])
		formatString: 0.000
		lineageTag: b30d5c09-3f36-53ad-bd81-1dd91d71177a

