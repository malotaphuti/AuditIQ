table fact_investigations
	lineageTag: eec0adde-ab3f-5a90-b52c-8c465c988a2b

	measure 'Investigations' = COUNTROWS(fact_investigations)
		formatString: #,0
		lineageTag: a53e91e1-c9ff-53df-a56d-4e7996420b8b

	measure 'Open Investigations' = CALCULATE(COUNTROWS(fact_investigations), fact_investigations[is_open] = TRUE())
		formatString: #,0
		lineageTag: e8a34ac7-6622-5f8b-886a-faedd23de196

	measure 'Investigations In Progress' = CALCULATE(COUNTROWS(fact_investigations), fact_investigations[status] IN {"UNDER_REVIEW", "AWAITING_EVIDENCE", "ESCALATED"})
		formatString: #,0
		lineageTag: 31dce7ab-6a70-54f2-b3b2-8a553ae45dfd

	measure 'Resolved Investigations' = CALCULATE(COUNTROWS(fact_investigations), fact_investigations[status] = "RESOLVED")
		formatString: #,0
		lineageTag: 48bd3963-4dca-5d78-8d74-fb8a0b5124c3

	measure 'Average Investigation Duration (h)' = AVERAGE(fact_investigations[resolution_hours])
		formatString: #,0.0
		lineageTag: 53df9398-ac0c-58d4-9f97-7a7c8f96f37e

