table fact_transactions
	lineageTag: 71593528-2244-52ba-84dc-81a853e711ae

	measure 'Total Transactions' = COUNTROWS(fact_transactions)
		formatString: #,0
		lineageTag: 152fb66e-16ba-5191-a435-ef0c5d19814d

	measure 'Total Transaction Value' = SUM(fact_transactions[amount])
		formatString: \R #,0
		lineageTag: 6c9c7e7d-8a22-56ba-a9c5-c7c362b5cb5c

	measure 'Flagged Transactions' = CALCULATE(COUNTROWS(fact_transactions), fact_transactions[is_flagged] = TRUE())
		formatString: #,0
		lineageTag: 3f9ef7d8-19f1-5a58-b674-5440684ea750

	measure 'Exception Rate %' = DIVIDE([Flagged Transactions], [Total Transactions])
		formatString: 0.00%
		lineageTag: c1394fc2-e916-5ea0-87a0-5cc93c6a7200

