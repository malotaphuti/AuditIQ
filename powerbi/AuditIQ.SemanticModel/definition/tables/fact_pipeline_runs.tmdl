table fact_pipeline_runs
	lineageTag: b0e62cb4-dafb-510a-97ec-9bb84562b13b

	measure 'Pipeline Runs' = COUNTROWS(fact_pipeline_runs)
		formatString: #,0
		lineageTag: ff70dba9-28ba-55f1-a475-4839d410b270

	measure 'Pipeline Success Rate %' = DIVIDE(CALCULATE(COUNTROWS(fact_pipeline_runs), fact_pipeline_runs[status] = "SUCCESS"), COUNTROWS(fact_pipeline_runs))
		formatString: 0.0%
		lineageTag: d5946f7e-e4f3-5b33-acc9-3611387043a0

	measure 'Records Received' = SUM(fact_pipeline_runs[total_records])
		formatString: #,0
		lineageTag: f6ee153f-71e3-5830-bacf-a72b9153bd35

	measure 'Valid Record Rate %' = DIVIDE(SUM(fact_pipeline_runs[valid_records]), SUM(fact_pipeline_runs[total_records]))
		formatString: 0.00%
		lineageTag: 05dbfb88-71de-5091-a0f2-97055f830489

