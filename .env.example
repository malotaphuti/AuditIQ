# Copy to .env and replace every value. Never commit .env.
# Generate strong secrets with e.g.:  openssl rand -base64 48

# --- PostgreSQL ---
POSTGRES_DB=auditiq
POSTGRES_USER=auditiq
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_PORT=5432

# --- Backend security ---
# At least 32 characters (HS256 key).
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
AUDITIQ_SELF_REGISTRATION=false
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Service-to-service key (backend -> analytics service) ---
ANALYTICS_SERVICE_KEY=change-me-random-service-key

# --- Demo users (created only on an empty database; leave blank to skip) ---
# Must satisfy the password policy: 12+ chars, upper, lower, digit, symbol.
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_AUDITOR_PASSWORD=
BOOTSTRAP_MANAGER_PASSWORD=

# --- Pipeline scheduling (0 = manual runs only) ---
PIPELINE_SCHEDULE_MINUTES=0
PIPELINE_SCHEDULED_TRANSACTIONS=20000

# --- Ports / logging ---
BACKEND_PORT=8080
FRONTEND_PORT=4200
LOG_LEVEL=INFO
